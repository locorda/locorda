---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/common.css';

interface Props {
	title: string;
	description?: string;
	activeNav?: 'rdf' | 'vocabularies' | 'sync' | 'docs';
	/** Absolute URL to an OG image; falls back to the site logo. */
	ogImage?: string;
	/** Page-specific JSON-LD schema objects, merged alongside the site-wide Organization + WebSite schemas. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, activeNav, ogImage, jsonLd } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://locorda.dev');
const resolvedOgImage = ogImage ?? `${canonicalUrl.origin}/logos/locorda-og.png`;

const baseSchemas = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: 'Locorda',
		url: 'https://locorda.dev',
		logo: 'https://locorda.dev/logo.svg',
		sameAs: ['https://github.com/locorda', 'https://pub.dev/publishers/locorda.dev'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Locorda',
		url: 'https://locorda.dev',
	},
];
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title} | Locorda</title>
	{description && <meta name="description" content={description} />}
	<link rel="canonical" href={canonicalUrl.href} />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={canonicalUrl.href} />
	<meta property="og:title" content={`${title} | Locorda`} />
	{description && <meta property="og:description" content={description} />}
	<meta property="og:image" content={resolvedOgImage} />

	<!-- Twitter / X Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={`${title} | Locorda`} />
	{description && <meta name="twitter:description" content={description} />}
	<meta name="twitter:image" content={resolvedOgImage} />

	<link rel="icon" type="image/svg+xml" href="/logo.svg" />
	<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

	<!-- Structured data -->
	<script type="application/ld+json" set:html={JSON.stringify(baseSchemas)} />
	{pageSchemas.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(pageSchemas)} />}
</head>
<body>
	<Header activeNav={activeNav} />
	
	<main>
		<slot />
	</main>
	
	<Footer />
</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	
	html {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		font-size: 16px;
		line-height: 1.5;
		scroll-behavior: smooth;
	}
	
	body {
		background: #ffffff;
		color: #0f172a;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	
	main {
		flex: 1;
	}
	
	h1, h2, h3, h4, h5, h6 {
		font-weight: 700;
		line-height: 1.2;
	}
	
	h1 {
		font-size: 3.5rem;
		font-weight: 900;
		letter-spacing: -0.04em;
	}
	
	h2 {
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	
	h3 {
		font-size: 1.75rem;
		font-weight: 700;
	}
	
	a {
		color: inherit;
		text-decoration: none;
	}
	
	code {
		font-family: 'Fira Code', 'Courier New', monospace;
	}
	
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}
	
	@media (max-width: 768px) {
		h1 {
			font-size: 2.5rem;
		}
		
		h2 {
			font-size: 2rem;
		}
		
		.container {
			padding: 0 1rem;
		}
		}
</style>
